#!/usr/bin/env node
// t3-claude-usage-proxy: the Claude usage proxy. It lets T3 Code show Claude
// limits on a box that signs in with a long-lived CLAUDE_CODE_OAUTH_TOKEN.
//
// T3 Code reads Claude limits from api/oauth/usage, which refuses the
// setup-token. T3 also accepts a "cliproxy" usage-limit source. This server
// answers the two management calls T3 makes to such a hub:
//
//   GET  /v0/management/auth-files   one Claude account
//   POST /v0/management/api-call     the oauth/usage body, built from `usage --json`
//
// It sends nothing to Anthropic. It runs `usage --json` with no fetch flag, so
// the numbers come from the caches `usage` reads, and can be old. T3 shows the
// reading time.
//
// The boot step (lib/steps/t3-claude-usage.sh) creates the key, writes the
// "devaloy-claude-usage" entry in ~/.t3/userdata/settings.json and starts this
// server from a restart loop in entrypoint.sh. The server never creates the
// key: without one it logs an error and exits.
//
// It logs its start, its errors and every 401 or 404, one line each. A normal
// request writes no line.
//
// Environment:
//   T3_CLAUDE_USAGE_PROXY_PORT   listen port (default 8317), always on 127.0.0.1
//   T3_CLAUDE_USAGE_PROXY_KEY    management key; default: ~/.config/t3-claude-usage-proxy/key
//   T3_CLAUDE_USAGE_PROXY_CMD    the usage command (default "usage")

"use strict";

const http = require("node:http");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");
const { execFile } = require("node:child_process");

const NAME = "t3-claude-usage-proxy";
const PORT = Number(process.env.T3_CLAUDE_USAGE_PROXY_PORT || 8317);
const USAGE_CMD = process.env.T3_CLAUDE_USAGE_PROXY_CMD || "usage";
const KEY_FILE = path.join(os.homedir(), ".config", NAME, "key");

function logLine(msg) {
  console.log(`${new Date().toISOString()} ${msg}`);
}

function logError(msg) {
  console.error(`${new Date().toISOString()} ERROR: ${msg}`);
}

function managementKey() {
  if (process.env.T3_CLAUDE_USAGE_PROXY_KEY) return process.env.T3_CLAUDE_USAGE_PROXY_KEY.trim();
  try {
    return fs.readFileSync(KEY_FILE, "utf8").trim();
  } catch (e) {
    logError(`cannot read the key ${KEY_FILE}: ${e.code || e.message}. The boot step creates it.`);
    return "";
  }
}
const KEY = managementKey();
if (!KEY) {
  if (fs.existsSync(KEY_FILE)) logError(`the key ${KEY_FILE} is empty`);
  process.exit(1);
}

function accountEmail() {
  try {
    const cfg = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".claude.json"), "utf8"));
    return cfg.oauthAccount?.emailAddress || undefined;
  } catch {
    return undefined;
  }
}

// `usage` stores resets_at as epoch seconds; oauth/usage uses ISO strings.
function toIso(value) {
  if (value == null || value === "" || value === "-") return null;
  const n = Number(value);
  if (Number.isFinite(n)) return new Date(n * 1000).toISOString();
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? null : d.toISOString();
}

// A window with no number (absent from the source) is null, not 0: T3 then
// shows no bar for it rather than a wrong one.
function toWindow(w) {
  if (!w || typeof w.utilization !== "number") return null;
  return { utilization: w.utilization, resets_at: toIso(w.resets_at) };
}

function readUsage() {
  return new Promise((resolve, reject) => {
    execFile(USAGE_CMD, ["--json"], { timeout: 20000 }, (err, stdout) => {
      if (err) return reject(err);
      try {
        const u = JSON.parse(stdout).utilization || {};
        resolve({ five_hour: toWindow(u.five_hour), seven_day: toWindow(u.seven_day) });
      } catch (e) {
        reject(e);
      }
    });
  });
}

function send(res, status, body) {
  res.writeHead(status, { "content-type": "application/json" });
  res.end(JSON.stringify(body));
}

function readBody(req) {
  return new Promise((resolve) => {
    let data = "";
    req.on("data", (c) => (data += c));
    req.on("end", () => {
      try { resolve(data ? JSON.parse(data) : {}); } catch { resolve({}); }
    });
    req.on("error", () => resolve({}));
  });
}

function urlPath(value) {
  try {
    return new URL(String(value)).pathname;
  } catch {
    return String(value || "").split("?")[0];
  }
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, "http://localhost");
  const auth = req.headers.authorization || "";
  const given = Buffer.from(auth.replace(/^Bearer\s+/i, ""));
  const want = Buffer.from(KEY);
  if (given.length !== want.length || !crypto.timingSafeEqual(given, want)) {
    logLine(`401 ${req.method} ${url.pathname}`);
    return send(res, 401, { error: "invalid management key" });
  }

  if (req.method === "GET" && url.pathname === "/v0/management/auth-files") {
    return send(res, 200, {
      files: [{ id: "claude-oauth-token", auth_index: "0", provider: "claude", email: accountEmail() }],
    });
  }

  if (req.method === "POST" && url.pathname === "/v0/management/api-call") {
    const body = await readBody(req);
    const target = urlPath(body.url);
    if (target !== "/api/oauth/usage") {
      logLine(`404 ${req.method} ${url.pathname} (api-call for ${target || "no url"})`);
      return send(res, 200, { status_code: 404, body: "{}" });
    }
    try {
      const usage = await readUsage();
      return send(res, 200, { status_code: 200, body: JSON.stringify(usage) });
    } catch (e) {
      logError(`${USAGE_CMD} --json failed: ${String(e.message || e).split("\n")[0]}`);
      return send(res, 200, { status_code: 502, body: JSON.stringify({ error: "usage failed" }) });
    }
  }

  logLine(`404 ${req.method} ${url.pathname}`);
  send(res, 404, { error: "not found" });
});

server.on("error", (e) => {
  logError(`cannot listen on 127.0.0.1:${PORT}: ${e.code || e.message}`);
  process.exit(1);
});

server.listen(PORT, "127.0.0.1", () => {
  logLine(`${NAME} listening on http://127.0.0.1:${PORT}`);
});
