#!/usr/bin/env bash
# Print the Claude Code 5-hour and 7-day usage limits on the terminal.
#
# Sources, newest reading wins:
#   ~/.claude.json                  .cachedUsageUtilization, written on OAuth /login
#   ~/.claude/usage-live-cache.json written by the statusline on every render,
#                                   and by --fetch and --curl
#   T3 provider logs                the last rate_limit_event of the default
#                                   claudeAgent instance in
#                                   ${T3CODE_HOME:-~/.t3}/userdata/logs/provider/
#                                   events.*.log*, files changed in the last 7 days
#
# A plain run reads these files only and sends no request, so the numbers are
# as fresh as the last Claude Code or T3 turn. The age and the source of the
# reading are always printed, so a stale value is visible rather than silent.
#
# A live reading is opt-in. --fetch runs one short `claude -p` turn and reads
# the rate_limit_event it streams. --curl sends the old 1-token request and
# reads the rate-limit headers. Both write the result to the statusline cache,
# so a later statusline render and this script agree. Both refuse to run when
# the newest reading is under 60 s old, unless --force is given.
#
# --fetch gives `claude` CLAUDE_CODE_OAUTH_TOKEN from the environment or from
# ~/.devaloy_secrets (where this box writes that variable, and which a login
# shell does not export); with neither, `claude` uses its own /login. --curl
# authenticates from CLAUDE_CODE_OAUTH_TOKEN, then ~/.devaloy_secrets, then the
# accessToken in ~/.claude/.credentials.json, then ANTHROPIC_API_KEY.
#
# Usage:
#   usage             coloured one-screen report from the caches
#   usage --line      one line: percent and time left per window
#   usage --json      the chosen reading, normalized, with its source
#   usage --fetch     live reading from one real `claude -p` Haiku turn
#   usage --curl      live reading from a 1-token API request sent by curl
#   usage --force     with --fetch or --curl: skip the 60 s floor
#   usage --no-fetch  accepted for old callers; does nothing
#
# A run without --fetch or --curl sends no request to Anthropic.
#
# Account risk: --fetch is a real automated Claude Code turn that spends
# tokens. --curl is a request from curl that claims to be Claude Code, and
# Anthropic's terms reserve the OAuth token for ordinary use of Claude Code.
# Use them by hand and rarely; never put them in a loop or a prompt.
#
# A window whose reset time has passed shows 0% with the reset time unknown;
# --json marks it "reset_inferred": true. Exit 3: a fetch refused by the floor.
#
# Colour is off when stdout is not a terminal or NO_COLOR is set.

set -u

CONFIG="${CLAUDE_CONFIG_FILE:-$HOME/.claude.json}"
FALLBACK="$HOME/.claude/usage-live-cache.json"
CREDENTIALS="$HOME/.claude/.credentials.json"
T3_LOG_DIR="${T3CODE_HOME:-$HOME/.t3}/userdata/logs/provider"
FETCH_FLOOR_S=60
MODE="report"
# none: read the caches only. claude: --fetch. curl: --curl.
FETCH="none"
FORCE=0

for arg in "$@"; do
    case "$arg" in
        --line) MODE="line" ;;
        --json) MODE="json" ;;
        --fetch) FETCH="claude" ;;
        --curl) FETCH="curl" ;;
        --force) FORCE=1 ;;
        --no-fetch) ;;
        -h|--help)
            sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "usage: usage [--line|--json] [--fetch|--curl] [--force]" >&2
            exit 2
            ;;
    esac
done

if ! command -v jq >/dev/null 2>&1; then
    echo "usage: jq is required" >&2
    exit 1
fi

now_ms() { date +%s%3N; }

# --- the cache sources -------------------------------------------------------
# Each reader prints one tab-separated line:
#   fetchedAtMs  five_pct  five_reset  seven_pct  seven_reset
# Missing, null and empty values become "-" so no field is ever blank, and a
# missing window stays "-" (unknown), never 0.

# read_cache_file FILE ROOT_EXPR — ROOT_EXPR is a jq filter locating the
# utilization block within FILE.
read_cache_file() {
    local file="$1" root="$2"
    [ -r "$file" ] || return 1
    jq -r "
        def v: if . == null or . == \"\" then \"-\" else . end;
        (${root}) as \$c
        | [ (\$c.fetchedAtMs | if type == \"number\" then floor else 0 end),
            (\$c.utilization.five_hour.utilization | v),
            (\$c.utilization.five_hour.resets_at | v),
            (\$c.utilization.seven_day.utilization | v),
            (\$c.utilization.seven_day.resets_at | v) ]
        | @tsv" "$file" 2>/dev/null
}

# jq definitions shared by the T3 log reader and --fetch: a rate_limit_event's
# unifiedWindows holds fractions (0.19 is 19 percent) and epoch-second resets.
JQ_WINDOWS='
    def pct: if type == "number" then (. * 10000 | round) / 100 else null end;
    def epoch: if . == null then null else tostring end;
    def win: if type == "object"
             then {utilization: (.utilization | pct), resets_at: (.resetsAt | epoch)}
             else {utilization: null, resets_at: null} end;
    def windows: {five_hour: (.five_hour | win), seven_day: (.seven_day | win)};'

# read_t3_log — the newest rate_limit_event that T3 logged for the default
# claudeAgent instance. Each log line is `[<ISO time>] <tag>: {json}`. Only the
# last matching line of each file is read, newest first, so the scan stays
# cheap on large logs. The line time, not the file mtime, picks the winner.
read_t3_log() {
    local f line best="" when json ms
    [ -d "$T3_LOG_DIR" ] || return 1
    while IFS= read -r -d '' f; do
        line=$(tac "$f" 2>/dev/null | LC_ALL=C grep -a -m1 \
            -e 'provider-instance:claudeAgent:.*"rate_limit_event".*"unifiedWindows"' \
            -e '"rate_limit_event".*"unifiedWindows".*provider-instance:claudeAgent:') \
            || continue
        # ISO 8601 UTC times sort as strings.
        [[ "$line" > "$best" ]] && best="$line"
    done < <(find "$T3_LOG_DIR" -maxdepth 1 -type f -name 'events.*.log*' -mtime -7 -print0 2>/dev/null)
    [ -n "$best" ] || return 1

    case "$best" in '['*'] '*': '*) ;; *) return 1 ;; esac
    when="${best#\[}"; when="${when%%\] *}"
    json="${best#*\] }"; json="${json#*: }"
    ms=$(date -d "$when" +%s%3N 2>/dev/null) || return 1
    printf '%s' "$json" | jq -r --arg ms "$ms" "$JQ_WINDOWS"'
        def v: if . == null then "-" else . end;
        select(.providerSessionId | type == "string"
               and contains("provider-instance:claudeAgent:"))
        | .event.payload | select(.type == "rate_limit_event")
        | .rate_limit_info.unifiedWindows | select(type == "object")
        | windows
        | [ $ms,
            (.five_hour.utilization | v), (.five_hour.resets_at | v),
            (.seven_day.utilization | v), (.seven_day.resets_at | v) ]
        | @tsv' 2>/dev/null
}

# take LABEL LINE — keep LINE as the reading when it holds a percentage and is
# newer than the one kept so far.
SOURCE_LABEL=""
FETCHED_MS=0
take() {
    local ms p5 r5 p7 r7
    [ -n "$2" ] || return 1
    IFS=$'\t' read -r ms p5 r5 p7 r7 <<<"$2"
    [ "${p5:--}" != "-" ] || [ "${p7:--}" != "-" ] || return 1
    case "$ms" in ''|*[!0-9]*) ms=0 ;; esac
    if [ -z "$SOURCE_LABEL" ] || [ "$ms" -gt "$FETCHED_MS" ]; then
        SOURCE_LABEL="$1" FETCHED_MS="$ms"
        FIVE_PCT="${p5:--}" FIVE_RESET="${r5:--}"
        SEVEN_PCT="${p7:--}" SEVEN_RESET="${r7:--}"
    fi
}

take "account cache" "$(read_cache_file "$CONFIG" ".cachedUsageUtilization")"
take "statusline cache" "$(read_cache_file "$FALLBACK" ".")"
take "t3 log" "$(read_t3_log)"

# --- live readings, on request only ------------------------------------------

# write_cache JSON — atomic write of $FALLBACK, the same temp file and mv as
# the statusline, which can render concurrently.
write_cache() {
    local tmp
    tmp=$(mktemp "$HOME/.claude/.usage-live-cache.XXXXXX" 2>/dev/null) || return 1
    printf '%s\n' "$1" > "$tmp" 2>/dev/null && mv "$tmp" "$FALLBACK" 2>/dev/null && return 0
    rm -f "$tmp" 2>/dev/null
    return 1
}

# fetch_claude — one real `claude -p` Haiku turn. --safe-mode turns off hooks,
# CLAUDE.md, MCP servers, plugins and skills, so agent-push and the other hooks
# do not run, and --no-session-persistence leaves no session file behind.
# The first rate_limit_event of the stream carries the numbers. The variables
# that tie a session to a parent Claude Code or T3 process are dropped, so the
# turn stands alone when `usage` runs inside one.
fetch_claude() {
    local token out event cache
    command -v claude >/dev/null 2>&1 || return 1
    command -v timeout >/dev/null 2>&1 || return 1

    token="${CLAUDE_CODE_OAUTH_TOKEN:-}"
    if [ -z "$token" ] && [ -r "$HOME/.devaloy_secrets" ]; then
        # shellcheck source=/dev/null
        token=$( . "$HOME/.devaloy_secrets" >/dev/null 2>&1
                 printf '%s' "${CLAUDE_CODE_OAUTH_TOKEN:-}" )
    fi

    local cmd=(timeout 60 claude -p --safe-mode --no-session-persistence
               --strict-mcp-config --model haiku
               --output-format stream-json --verbose
               "Reply with exactly one word: ok")
    out=$(
        unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID \
              CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_MESSAGING_SOCKET \
              CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_PID
        # The token goes to the `claude` child only, never to this shell.
        if [ -n "$token" ]; then
            CLAUDE_CODE_OAUTH_TOKEN="$token" "${cmd[@]}" </dev/null 2>/dev/null
        else
            "${cmd[@]}" </dev/null 2>/dev/null
        fi
    )
    event=$(printf '%s\n' "$out" | grep -m1 '"type":"rate_limit_event"') || return 1
    cache=$(printf '%s' "$event" | jq -c --argjson ms "$(now_ms)" "$JQ_WINDOWS"'
        .rate_limit_info.unifiedWindows | select(type == "object") | windows
        | select(.five_hour.utilization != null or .seven_day.utilization != null)
        | {fetchedAtMs: $ms, utilization: .}' 2>/dev/null)
    [ -n "$cache" ] || return 1
    write_cache "$cache"
}

# oauth_token — the bearer token for --curl, from the first source that has
# one:
#
#   1. CLAUDE_CODE_OAUTH_TOKEN in the environment.
#   2. ~/.devaloy_secrets, which is where the entrypoint writes that variable.
#      A login shell does not export it, so an interactive `usage --curl`
#      sees an empty environment variable on a token-provisioned box.
#   3. ~/.claude/.credentials.json, written by `/login`. Its accessToken is
#      the same kind of OAuth token and the API accepts it the same way.
#
# An expired accessToken is skipped rather than sent: the API would answer 401
# and the probe would fail anyway. Nothing here refreshes it — a `claude`
# session does that, and the next probe picks up the rewritten file.
oauth_token() {
    local t exp now_ms
    if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
        printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN"; return 0
    fi
    if [ -r "$HOME/.devaloy_secrets" ]; then
        # shellcheck source=/dev/null
        t=$( . "$HOME/.devaloy_secrets" >/dev/null 2>&1
             printf '%s' "${CLAUDE_CODE_OAUTH_TOKEN:-}" )
        if [ -n "$t" ]; then printf '%s' "$t"; return 0; fi
    fi
    if [ -r "$CREDENTIALS" ]; then
        t=$(jq -r '.claudeAiOauth.accessToken // empty' "$CREDENTIALS" 2>/dev/null)
        exp=$(jq -r '.claudeAiOauth.expiresAt // 0 | floor' "$CREDENTIALS" 2>/dev/null)
        case "$exp" in ''|*[!0-9]*) exp=0 ;; esac
        now_ms=$(( $(date +%s) * 1000 ))
        if [ -n "$t" ] && { [ "$exp" -eq 0 ] || [ "$exp" -gt "$now_ms" ]; }; then
            printf '%s' "$t"; return 0
        fi
    fi
    return 1
}

# probe — the --curl reading. Claude Code's own /api/oauth/usage endpoint
# rejects a long-lived CLAUDE_CODE_OAUTH_TOKEN with 403, so the numbers come
# from the rate-limit headers on a max_tokens:1 Haiku call (about 23 input
# tokens and 1 output token). Returns non-zero and stays silent on any failure.
probe() {
    local auth=() headers pct5 reset5 pct7 reset7 tmp now_ms token
    command -v curl >/dev/null 2>&1 || return 1

    token=$(oauth_token) || token=""
    if [ -n "$token" ]; then
        auth=(-H "Authorization: Bearer $token"
              -H "anthropic-beta: oauth-2025-04-20")
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        auth=(-H "x-api-key: $ANTHROPIC_API_KEY")
    else
        return 1
    fi

    # The OAuth token is only accepted for Claude Code, which the system prompt
    # identifies. It is required, not decoration.
    headers=$(curl -sS --max-time 10 -D - -o /dev/null \
        https://api.anthropic.com/v1/messages \
        "${auth[@]}" \
        -H "anthropic-version: 2023-06-01" \
        -H "content-type: application/json" \
        -d '{"model":"claude-haiku-4-5-20251001","max_tokens":1,
             "system":[{"type":"text","text":"You are Claude Code, Anthropic'"'"'s official CLI for Claude."}],
             "messages":[{"role":"user","content":"hi"}]}' 2>/dev/null) || return 1

    # Header names are lower case over HTTP/2 but not guaranteed to be, and the
    # values are fractions: 0.57 is 57 percent.
    hdr() {
        printf '%s' "$headers" \
            | tr -d '\r' \
            | awk -v k="anthropic-ratelimit-unified-$1:" \
                  'tolower($1) == k {print $2; exit}'
    }
    pct5=$(hdr 5h-utilization); reset5=$(hdr 5h-reset)
    pct7=$(hdr 7d-utilization); reset7=$(hdr 7d-reset)
    [ -n "$pct5" ] && [ -n "$pct7" ] || return 1
    pct5=$(awk -v v="$pct5" 'BEGIN {print v * 100}')
    pct7=$(awk -v v="$pct7" 'BEGIN {print v * 100}')

    # Same atomic write as the statusline, which can render concurrently.
    tmp=$(mktemp "$HOME/.claude/.usage-live-cache.XXXXXX" 2>/dev/null) || return 1
    now_ms=$(( $(date +%s) * 1000 ))
    printf '{"fetchedAtMs": %s, "utilization": {"five_hour": {"utilization": %s, "resets_at": "%s"}, "seven_day": {"utilization": %s, "resets_at": "%s"}}}\n' \
        "$now_ms" "$pct5" "$reset5" "$pct7" "$reset7" > "$tmp" 2>/dev/null \
        && mv "$tmp" "$FALLBACK" 2>/dev/null && return 0
    rm -f "$tmp" 2>/dev/null
    return 1
}

if [ "$FETCH" != "none" ]; then
    # The floor: a reading under 60 s old is fresh enough, and each fetch is a
    # request on the account.
    if [ "$FORCE" = 0 ] && [ -n "$SOURCE_LABEL" ] && [ "$FETCHED_MS" -gt 0 ]; then
        age_s=$(( ($(now_ms) - FETCHED_MS) / 1000 ))
        [ "$age_s" -lt 0 ] && age_s=0
        if [ "$age_s" -lt "$FETCH_FLOOR_S" ]; then
            echo "usage: newest reading is $age_s s old ($SOURCE_LABEL); use --force to fetch anyway" >&2
            exit 3
        fi
    fi
    if [ "$FETCH" = "claude" ]; then fetcher=fetch_claude live="live (claude -p)"
    else fetcher=probe live="live (curl)"; fi
    if "$fetcher"; then
        # The reading just written wins outright, whatever the clocks say.
        SOURCE_LABEL=""
        take "$live" "$(read_cache_file "$FALLBACK" ".")"
    else
        echo "usage: fetch failed, showing the cached reading" >&2
    fi
fi

if [ -z "$SOURCE_LABEL" ]; then
    echo "usage: no cached usage in $CONFIG, $FALLBACK or the T3 logs in $T3_LOG_DIR — start a Claude Code session once" >&2
    exit 1
fi

TIER="-"
if [ "$SOURCE_LABEL" = "account cache" ]; then
    TIER=$(jq -r '.oauthAccount.organizationRateLimitTier // "-"' "$CONFIG" 2>/dev/null)
fi

# --- time helpers ------------------------------------------------------------
now=$(date +%s)
today=$(date +%Y-%m-%d)

# Epoch seconds of an ISO 8601 or unix-epoch timestamp; empty when unparsable.
epoch_of() {
    local ts="$1"
    case "$ts" in
        ""|-) return 1 ;;
        *[!0-9]*) date -d "$ts" +%s 2>/dev/null ;;
        *) echo "$ts" ;;
    esac
}

# The reset rule: a window whose reset time has passed has turned over, so it
# reads 0% with the next reset unknown. *_INFERRED marks it for --json.
FIVE_INFERRED=false
SEVEN_INFERRED=false
secs=$(epoch_of "$FIVE_RESET") || secs=""
if [ -n "$secs" ] && [ "$secs" -le "$now" ]; then
    FIVE_PCT=0 FIVE_RESET="-" FIVE_INFERRED=true
fi
secs=$(epoch_of "$SEVEN_RESET") || secs=""
if [ -n "$secs" ] && [ "$secs" -le "$now" ]; then
    SEVEN_PCT=0 SEVEN_RESET="-" SEVEN_INFERRED=true
fi

if [ "$MODE" = "json" ]; then
    jq -n --argjson ms "$FETCHED_MS" --arg src "$SOURCE_LABEL" \
        --arg p5 "$FIVE_PCT" --arg r5 "$FIVE_RESET" --argjson i5 "$FIVE_INFERRED" \
        --arg p7 "$SEVEN_PCT" --arg r7 "$SEVEN_RESET" --argjson i7 "$SEVEN_INFERRED" '
        def num: if . == "-" then null else (tonumber? // null) end;
        def str: if . == "-" then null else . end;
        def win(p; r; i):
            {utilization: (p | num), resets_at: (r | str)}
            + (if i then {reset_inferred: true} else {} end);
        {fetchedAtMs: $ms, source: $src,
         utilization: {five_hour: win($p5; $r5; $i5), seven_day: win($p7; $r7; $i7)}}'
    exit 0
fi

# --- colours: Catppuccin Mocha, same ramp as the status line -----------------
RESET="\033[0m"
GREEN="\033[38;2;166;227;161m"
LAVENDER="\033[38;2;180;190;254m"
PEACH="\033[38;2;250;179;135m"
PINK="\033[38;2;243;139;168m"
LABEL="\033[38;2;147;153;178m"
SEP="\033[38;2;88;91;112m"

if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then
    RESET="" GREEN="" LAVENDER="" PEACH="" PINK="" LABEL="" SEP=""
fi

# pick_color PCT — "-" (unknown) takes the label colour.
pick_color() {
    if   [ "$1" = "-" ];  then printf '%b' "$LABEL"
    elif [ "$1" -ge 80 ]; then printf '%b' "$PINK"
    elif [ "$1" -ge 70 ]; then printf '%b' "$PEACH"
    elif [ "$1" -ge 60 ]; then printf '%b' "$LAVENDER"
    else                       printf '%b' "$GREEN"
    fi
}

# Round to an integer and clamp to 0-100; "-" (unknown) stays "-", anything
# else non-numeric becomes 0.
clamp_pct() {
    [ "${1:--}" = "-" ] && { echo "-"; return; }
    awk -v s="$1" 'BEGIN {
        v = int(s + 0.5)
        if (v < 0) v = 0
        if (v > 100) v = 100
        print v
    }'
}

# "18%", or "-" when the window is unknown.
pct_text() {
    if [ "$1" = "-" ]; then echo "-"; else echo "$1%"; fi
}

# "in 3h 12m" until the reset, "due" when the window already turned over,
# or empty when the reset time is unknown.
time_left() {
    local secs d h m
    secs=$(epoch_of "$1") || return 0
    [ -n "$secs" ] || return 0
    d=$(( secs - now ))
    if [ "$d" -le 0 ]; then echo "due"; return; fi
    h=$(( d / 3600 )); m=$(( (d % 3600) / 60 ))
    if [ "$h" -gt 0 ]; then echo "in ${h}h ${m}m"; else echo "in ${m}m"; fi
}

# Wall-clock reset time in the local zone. Adds the date when it is not today.
reset_at() {
    local secs
    secs=$(epoch_of "$1") || return 0
    [ -n "$secs" ] || return 0
    if [ "$(date -d "@$secs" +%Y-%m-%d)" = "$today" ]; then
        date -d "@$secs" +"%H:%M %Z"
    else
        date -d "@$secs" +"%a %d %b %H:%M %Z"
    fi
}

# "resets 23:59 UTC (in 3h 12m)", with the unknown pieces left out.
reset_text() {
    local at left
    at=$(reset_at "$1"); left=$(time_left "$1")
    if   [ -n "$at" ] && [ -n "$left" ]; then echo "resets $at ($left)"
    elif [ -n "$at" ];                    then echo "resets $at"
    else                                       echo "reset time unknown"
    fi
}

bar() {
    local pct="$1" width=24 filled i out=""
    [ "$pct" = "-" ] && pct=0
    filled=$(( pct * width / 100 ))
    for (( i = 0; i < width; i++ )); do
        if [ "$i" -lt "$filled" ]; then out="${out}█"; else out="${out}░"; fi
    done
    printf '%s' "$out"
}

FIVE_PCT=$(clamp_pct "$FIVE_PCT")
SEVEN_PCT=$(clamp_pct "$SEVEN_PCT")

case "$FETCHED_MS" in
    ""|-|*[!0-9]*|0) AGE="age unknown" ;;
    *)
        AGE_MIN=$(( (now - FETCHED_MS / 1000) / 60 ))
        if [ "$AGE_MIN" -lt 1 ]; then AGE="read just now"
        elif [ "$AGE_MIN" -lt 60 ]; then AGE="read ${AGE_MIN}m ago"
        elif [ "$AGE_MIN" -lt 1440 ]; then AGE="read $(( AGE_MIN / 60 ))h $(( AGE_MIN % 60 ))m ago"
        else AGE="read $(( AGE_MIN / 1440 ))d $(( (AGE_MIN % 1440) / 60 ))h ago"
        fi
        ;;
esac

if [ "$MODE" = "line" ]; then
    FIVE_LEFT=$(time_left "$FIVE_RESET"); SEVEN_LEFT=$(time_left "$SEVEN_RESET")
    printf '%b5h%b %b%s%b %b(%s)%b%b | %b%b7d%b %b%s%b %b(%s)%b\n' \
        "$LABEL" "$RESET" "$(pick_color "$FIVE_PCT")" "$(pct_text "$FIVE_PCT")" "$RESET" \
        "$LABEL" "${FIVE_LEFT:-?}" "$RESET" \
        "$SEP" "$RESET" \
        "$LABEL" "$RESET" "$(pick_color "$SEVEN_PCT")" "$(pct_text "$SEVEN_PCT")" "$RESET" \
        "$LABEL" "${SEVEN_LEFT:-?}" "$RESET"
    exit 0
fi

printf '\n'
printf '  %b5 hour%b   %b%s%b %b%4s%b   %b%s%b\n' \
    "$LABEL" "$RESET" \
    "$(pick_color "$FIVE_PCT")" "$(bar "$FIVE_PCT")" "$RESET" \
    "$(pick_color "$FIVE_PCT")" "$(pct_text "$FIVE_PCT")" "$RESET" \
    "$LABEL" "$(reset_text "$FIVE_RESET")" "$RESET"
printf '  %b7 day%b    %b%s%b %b%4s%b   %b%s%b\n' \
    "$LABEL" "$RESET" \
    "$(pick_color "$SEVEN_PCT")" "$(bar "$SEVEN_PCT")" "$RESET" \
    "$(pick_color "$SEVEN_PCT")" "$(pct_text "$SEVEN_PCT")" "$RESET" \
    "$LABEL" "$(reset_text "$SEVEN_RESET")" "$RESET"
if [ "$TIER" = "-" ]; then
    printf '\n  %b%s · %s%b\n\n' "$SEP" "$SOURCE_LABEL" "$AGE" "$RESET"
else
    printf '\n  %b%s · %s · %s%b\n\n' "$SEP" "$TIER" "$SOURCE_LABEL" "$AGE" "$RESET"
fi
