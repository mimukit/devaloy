# devaloy sshd config — key-only auth, single non-root user, persistent host keys.
Port 2222

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
UsePAM yes
X11Forwarding no
PrintMotd no
AllowUsers dev

# Generated into the persistent home by entrypoint.sh so identity survives
# redeploys and image rebuilds (no client MITM warnings).
HostKey /home/dev/.ssh/host_keys/ssh_host_rsa_key
HostKey /home/dev/.ssh/host_keys/ssh_host_ecdsa_key
HostKey /home/dev/.ssh/host_keys/ssh_host_ed25519_key

Subsystem sftp /usr/lib/openssh/sftp-server
