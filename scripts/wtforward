#!/bin/sh
# Runs on the LAPTOP, not on the box. Keeps one SSH ControlMaster connection
# to the box and mirrors its dev-server ports to the laptop, with the same port
# number on both sides, so http://localhost:<port> opens the box's server.
#
#   every WTFORWARD_INTERVAL seconds   read the box's TCP listeners (ss -ltnH)
#   a new listener in 10000-19999      ssh -O forward -L p:127.0.0.1:p
#   or in WTFORWARD_EXTRA
#   a listener that went away          ssh -O cancel
#
# POSIX sh and ssh only, for macOS and Linux. Install it with
#   scp devaloy:projects/devaloy/scripts/wtforward ~/.local/bin/
# See docs/wiki/run-worktrees-in-parallel.md.
set -u

usage() {
  echo "usage: wtforward [host]   (default host: devaloy; Ctrl+C stops)"
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  -*) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

host="${1:-devaloy}"
interval="${WTFORWARD_INTERVAL:-2}"
# The main checkouts keep the projects' default ports, so those are not hashed.
extra="${WTFORWARD_EXTRA:-3000 3001 3002 4000}"

case "$interval" in
  '' | . | *[!0-9.]* | *.*.*)
    echo "wtforward: WTFORWARD_INTERVAL must be a number of seconds" >&2
    exit 2
    ;;
esac
for p in $extra; do
  case "$p" in
    *[!0-9]*)
      echo "wtforward: WTFORWARD_EXTRA holds '$p', which is not a port number" >&2
      exit 2
      ;;
  esac
done

# A private directory, so two runs never share a socket and nobody else can
# open it. The socket path stays short enough for the 104-byte macOS limit.
dir=$(mktemp -d "${TMPDIR:-/tmp}/wtforward.XXXXXX") || exit 1
sock="$dir/master"

# Every client call goes through the master, never a new connection.
mux() {
  ssh -S "$sock" -o ControlMaster=no "$@"
}

cleanup() {
  trap - EXIT INT TERM HUP
  mux -O exit "$host" >/dev/null 2>&1
  rm -rf "$dir"
}
trap cleanup EXIT
trap 'cleanup; echo "closed the connection to $host"; exit 130' INT
trap 'cleanup; exit 143' TERM HUP

if ! ssh -M -S "$sock" -fN -o ControlPersist=no "$host"; then
  echo "wtforward: cannot connect to $host" >&2
  exit 1
fi
echo "connected to $host; checking its listeners every ${interval}s"

# Reads ss -ltnH output and prints each wanted port once. ss lists a port once
# per address family, and the port is the last colon-separated field of the
# local address in column 4 (127.0.0.1:p, [::]:p, *:p).
wanted_ports() {
  awk -v extra="$extra" '
    BEGIN { n = split(extra, e, " "); for (i = 1; i <= n; i++) want[e[i] + 0] = 1 }
    {
      p = $4; sub(/.*:/, "", p)
      if (p !~ /^[0-9]+$/) next
      p += 0
      if (((p >= 10000 && p <= 19999) || (p in want)) && !(p in seen)) { seen[p] = 1; print p }
    }' | sort -n
}

has() {
  case " $1 " in *" $2 "*) return 0 ;; esac
  return 1
}

active=""   # ports forwarded now
skipped=""  # ports that failed to forward; warned once, kept until they go away

while :; do
  if ! listeners=$(mux "$host" ss -ltnH 2>&1); then
    if mux -O check "$host" >/dev/null 2>&1; then
      echo "wtforward: cannot read the listeners on $host: $listeners" >&2
    else
      echo "wtforward: the connection to $host closed" >&2
    fi
    exit 1
  fi
  wanted=$(printf '%s\n' "$listeners" | wanted_ports)

  for p in $wanted; do
    if has "$active $skipped" "$p"; then
      continue
    fi
    if err=$(mux -O forward -L "$p:127.0.0.1:$p" "$host" 2>&1); then
      active="$active $p"
      echo "forward localhost:$p -> $host:$p"
    else
      skipped="$skipped $p"
      echo "wtforward: port $p is in use on this machine, skipped ($(printf '%s\n' "$err" | head -n 1))" >&2
    fi
  done

  keep=""
  for p in $active; do
    if has "$wanted" "$p"; then
      keep="$keep $p"
    else
      mux -O cancel -L "$p:127.0.0.1:$p" "$host" >/dev/null 2>&1
      echo "cancel localhost:$p ($host:$p stopped)"
    fi
  done
  active="$keep"

  keep=""
  for p in $skipped; do
    if has "$wanted" "$p"; then
      keep="$keep $p"
    fi
  done
  skipped="$keep"

  sleep "$interval"
done
