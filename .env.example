# Reusable, NON-EXPIRING, UNTAGGED auth key.
# Untagged => user-owned node => the autogroup:self ACL rule matches.
# After first boot, DISABLE KEY EXPIRY in the admin console or you WILL be locked out.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# GitHub PAT — logs in gh and git-over-HTTPS with no interactive flow.
# Classic: repo, read:org, gh-workflow. Fine-grained: contents + PRs.
# It is written to ~/.devaloy_secrets (0600) in the home volume, so treat the
# volume as holding a live credential. Leave empty to skip and use gh auth
# login by hand — gh refuses that flow while this variable is set.
GITHUB_TOKEN=

# Claude Code OAuth token — logs the agent in with no `/login` on the box.
# Generate it on your own machine with `claude setup-token` (needs Pro/Max or
# a Team/Enterprise seat) and paste the printed token here. Valid for a year,
# never self-refreshes. Written to ~/.devaloy_secrets (0600) like the PAT above.
# Leave empty to run `/login` inside the container instead — while this is set,
# an interactive login on the box is ignored.
CLAUDE_CODE_OAUTH_TOKEN=

# Push notifications to your phone via ntfy (https://ntfy.sh) when an agent on
# this box blocks for permission or finishes a long turn. OFF unless NTFY_TOPIC
# is set. The topic string IS the credential: an ntfy.sh topic is unreserved, so
# anyone who knows it can subscribe and read every message. Pick a LONG, RANDOM
# string (e.g. `openssl rand -hex 16`), not a guessable name. Messages carry
# metadata only — agent, repo basename, state, elapsed, host — never prompt or
# assistant text. Subscribe by opening https://ntfy.sh/<your-topic> in the app.
# NTFY_TOPIC=devaloy-CHANGE-ME-to-something-long-and-random
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Build the optional Orca runtime into the image, so the Orca desktop and
# mobile apps can pair with this box. Off by default — it takes the image from
# 683 MB to 1.6 GB. This is a BUILD arg: changing it needs `docker compose up -d
# --build`, not a plain restart. There is no runtime kill switch.
# WITH_ORCA=false

# TS_HOSTNAME=devaloy
# TS_ACCEPT_DNS=false
# MISE_NODE_VERSION=24
# MISE_HERDR_VERSION=latest
