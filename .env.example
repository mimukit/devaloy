# Reusable, non-expiring Tailscale auth key for the sidecar's node.
# Generate at https://login.tailscale.com/admin/settings/keys — tag it
# (e.g. tag:devbox), mark it reusable + non-expiring so redeploys don't
# require a new key.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SSH public key(s) allowed to log in as `dev`. Newline-separated for
# multiple devices (e.g. phone + laptop). Quote the value to preserve
# the embedded newlines.
PUBLIC_KEY="ssh-ed25519 AAAA... laptop
ssh-ed25519 AAAA... phone"
