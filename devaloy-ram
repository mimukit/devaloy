#!/usr/bin/env bash
# Reclaim RAM inside this box, by hand.
#
# Written for the two-boxes-on-one-VPS shape, where each container runs under a
# mem_limit and the cgroup OOM killer is the thing you are trying not to meet.
# The point is to give back the memory that long-lived supervisors accumulate
# BEFORE the ceiling fires, so you lose a daemon you can restart instead of an
# agent session halfway through a turn.
#
# REPORTS BY DEFAULT. Nothing is killed until you pass --apply. That is the same
# contract scripts/host-resource-guard.sh uses, and for the same reason: the
# things worth killing here look a lot like the things worth keeping.
#
# What it will NOT do, on purpose:
#
#   drop_caches   `echo 3 > /proc/sys/vm/drop_caches` is NOT namespaced. Writing
#                 it from this container drops the page cache of the WHOLE HOST,
#                 including the databases behind somebody's live site. The
#                 reclaimed number looks great and the cost lands on a neighbour.
#   dev servers   A `next dev` or a `vite` holding 800 MB is usually a server
#                 you are still using. They are reported, never killed. Stop
#                 them yourself.
#
# Usage: devaloy-ram [--apply] [--paseo] [--orphans] [--age <minutes>]
#   --apply          actually restart and kill. Without it, this only reports.
#   --paseo          only the Paseo daemon restart
#   --orphans        only the orphaned language-server reap
#   --age <minutes>  an orphan must be idle this long to qualify. Default 60.
#
# With neither --paseo nor --orphans, both run.
set -euo pipefail

APPLY=0
DO_PASEO=0
DO_ORPHANS=0
ORPHAN_AGE_MIN=60

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1; shift ;;
    --paseo) DO_PASEO=1; shift ;;
    --orphans) DO_ORPHANS=1; shift ;;
    --age) ORPHAN_AGE_MIN="${2:?--age needs a number of minutes, e.g. 120}"; shift 2 ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "devaloy-ram: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ "${DO_PASEO}" -eq 0 ] && [ "${DO_ORPHANS}" -eq 0 ]; then
  DO_PASEO=1
  DO_ORPHANS=1
fi

# --- reading the cgroup ---------------------------------------------------
#
# `free` inside a container reports the HOST's memory, not this container's, so
# it is the wrong number to act on when the whole point is a per-container
# mem_limit. These four files are the container's own accounting. cgroup v2 only
# — v1 spells them differently, and every devaloy host this was written for
# reports cgroup2fs (check with `stat -fc %T /sys/fs/cgroup/`).
CG=/sys/fs/cgroup

read_cg() {
  # $1 = file name. Prints the value, or an empty string when the file is
  # missing (cgroup v1) or reads "max" (no limit set).
  [ -r "${CG}/$1" ] || return 0
  local v
  v="$(cat "${CG}/$1" 2>/dev/null || true)"
  [ "${v}" = "max" ] && return 0
  printf '%s' "${v}"
}

human() {
  # bytes -> MiB, integer. Deliberately not `numfmt`: this needs to work the
  # same in the minimal shell the entrypoint uses.
  local b="${1:-}"
  [ -z "${b}" ] && { printf 'unlimited'; return; }
  printf '%s MiB' "$((b / 1024 / 1024))"
}

report_memory() {
  local when="$1"
  local cur max swap swapmax
  cur="$(read_cg memory.current)"
  max="$(read_cg memory.max)"
  swap="$(read_cg memory.swap.current)"
  swapmax="$(read_cg memory.swap.max)"

  echo "devaloy-ram: container memory ${when}"
  if [ -z "${cur}" ]; then
    echo "  (no cgroup v2 accounting readable — is this cgroup v1?)"
    return
  fi
  echo "  RAM  $(human "${cur}") of $(human "${max}")"
  echo "  swap $(human "${swap}") of $(human "${swapmax}")"
  if [ -n "${max}" ] && [ -n "${cur}" ]; then
    echo "  used $(( cur * 100 / max ))% of the ceiling"
  else
    echo "  NOTE: no mem_limit is set. Nothing here protects the host — see"
    echo "        docs/wiki/vm-resource-limits.md."
  fi
}

top_consumers() {
  echo
  echo "devaloy-ram: top 10 processes by RSS"
  # --sort takes the largest first; the head keeps the output to one screen.
  ps -eo rss=,pid=,ppid=,comm=,args= --sort=-rss 2>/dev/null | head -10 |
    while read -r rss pid ppid comm args; do
      printf '  %8s MiB  pid %-7s ppid %-7s %s\n' \
        "$((rss / 1024))" "${pid}" "${ppid}" "${comm}"
      # args is read but unused in the line above on purpose: a Claude Code
      # command line runs to hundreds of columns and wraps the whole report.
      : "${args}"
    done
}

# --- the Paseo daemon -----------------------------------------------------
#
# This is the reclaim that pays for the script. The daemon is long-lived by
# design and it accumulates: it holds a session per pane and outlives every one
# of them. Restarting it is cheap because entrypoint.sh supervises it in a
# `while true` loop and brings it back 10 seconds after it exits, with the same
# config from ~/.paseo/config.json. So killing it IS the restart.
#
# `paseo daemon restart` does the same thing through the CLI. pkill is used here
# because it also works when the daemon is wedged badly enough that the CLI's
# own RPC call hangs, which is the state you are usually in when you came
# looking for this script.
#
# WHAT YOU LOSE: every pane the daemon owns. An agent mid-turn in one of those
# panes is killed with it. Run this between turns, not during one.
#
# The two big children are usually @getpaseo/server workers, not panes. Paseo's
# inner supervisor restarts a worker that dies on its own, so killing ONE of
# them by pid is a narrower reclaim that keeps your sessions. That is not
# automated here because nothing in Paseo's contract promises the sessions
# survive it — do it by hand, watch what happens, and fall back to the full
# restart below when it does not work.
paseo_pids() {
  pgrep -f 'paseo daemon' 2>/dev/null || true
}

# The supervisor's own RSS is a rounding error — measured at 66 MiB on a box
# where the restart reclaimed 3.2 GiB. The memory is in its CHILDREN: the daemon
# parents every pane, every agent session and every worker it spawns, and those
# are what die with it. Reporting the supervisor alone makes the restart look
# pointless, which is the opposite of true.
#
# Walks the tree breadth-first from the supervisor PIDs. A depth cap is not
# needed — ps output is a finite set and each PID is visited once.
paseo_tree() {
  local frontier="$1" seen="" next pid
  while [ -n "${frontier}" ]; do
    seen="${seen} ${frontier}"
    next=""
    for pid in ${frontier}; do
      next="${next} $(pgrep -P "${pid}" 2>/dev/null | tr '\n' ' ')"
    done
    frontier="$(echo "${next}" | tr ' ' '\n' | grep -v '^$' || true)"
  done
  echo "${seen}" | tr ' ' '\n' | grep -v '^$' | sort -un
}

do_paseo() {
  local roots pids rss total=0 count=0
  roots="$(paseo_pids)"

  if [ -z "${roots}" ]; then
    echo
    echo "devaloy-ram: no Paseo daemon running (WITH_PASEO off, or it is down)"
    return 0
  fi

  pids="$(paseo_tree "${roots}")"

  for pid in ${pids}; do
    rss="$(awk '/^VmRSS:/ {print $2}' "/proc/${pid}/status" 2>/dev/null || true)"
    [ -n "${rss}" ] && total=$((total + rss)) && count=$((count + 1))
  done

  echo
  echo "devaloy-ram: the Paseo daemon and its children hold $((total / 1024)) MiB across ${count} process(es)"
  echo "devaloy-ram: the largest of them"
  for pid in ${pids}; do
    ps -o rss=,pid=,comm= -p "${pid}" 2>/dev/null || true
  done | sort -rn | head -5 |
    while read -r rss pid comm; do
      printf '  %6s MiB  pid %-7s %s\n' "$((rss / 1024))" "${pid}" "${comm}"
    done

  if [ "${APPLY}" -eq 0 ]; then
    echo "devaloy-ram: would restart it (--apply to do it)"
    return 0
  fi

  echo "devaloy-ram: stopping the daemon — every open pane dies with it"
  # SIGTERM, not SIGKILL. Paseo's own supervisor flushes session state and
  # releases the PID lock under ~/.paseo on a clean signal; a -9 leaves the lock
  # behind and the restart then fights it.
  pkill -f 'paseo daemon' || true

  # The supervisor loop in entrypoint.sh sleeps 10s before restarting, so this
  # waits past that and then confirms. Without the confirmation you cannot tell
  # a successful restart from a daemon that is now permanently down.
  local waited=0
  while [ "${waited}" -lt 40 ]; do
    sleep 2
    waited=$((waited + 2))
    if [ -n "$(paseo_pids)" ]; then
      echo "devaloy-ram: daemon back up after ${waited}s"
      return 0
    fi
  done

  echo "devaloy-ram: WARNING — the daemon has not come back after ${waited}s." >&2
  echo "devaloy-ram: check 'docker logs' for this container; the supervisor" >&2
  echo "devaloy-ram: retries every 10s and logs each failure." >&2
  return 0
}

# --- orphaned language servers --------------------------------------------
#
# An editor or an agent session that dies without reaping its children leaves
# tsserver, rust-analyzer and friends running forever, reparented to PID 1. Each
# one holds its whole project index in RAM. They are the second biggest reclaim
# on a box that has been up for weeks, and unlike a dev server nothing is
# waiting on them.
#
# Two conditions, both required, because either alone is wrong:
#
#   ppid == 1     the parent is gone. A live server under a live editor has a
#                 real parent and is not touched.
#   idle >= age   it has burned no CPU recently. Guards the window between a
#                 supervisor exiting and its child being cleaned up normally.
ORPHAN_MATCH='tsserver|typescript-language-server|vtsls|rust-analyzer|gopls|pyright|pylance|eslint_d|biome __server|jdtls'

do_orphans() {
  echo
  echo "devaloy-ram: orphaned language servers (ppid 1, idle >= ${ORPHAN_AGE_MIN}m)"

  local found=0 total=0 now started age
  now="$(date +%s)"

  # Age comes from the mtime of /proc/<pid>, which the kernel sets at process
  # start. `ps -o etimes` is the obvious choice and it is WRONG here: it derives
  # elapsed time from the host boot clock, and inside a container on a host that
  # has been suspended or migrated it returns nonsense. Measured on this box it
  # reported 4121799776 seconds — 130 years — for every process, which passes
  # any age test you write and turns the guard into a no-op.
  while read -r pid ppid rss cputime comm; do
    [ "${ppid}" = "1" ] || continue

    started="$(stat -c %Y "/proc/${pid}" 2>/dev/null || true)"
    [ -n "${started}" ] || continue
    age=$((now - started))
    [ "${age}" -ge $((ORPHAN_AGE_MIN * 60)) ] || continue

    found=$((found + 1))
    total=$((total + rss))
    printf '  %6s MiB  pid %-7s up %sm  cpu %ss  %s\n' \
      "$((rss / 1024))" "${pid}" "$((age / 60))" "${cputime}" "${comm}"

    if [ "${APPLY}" -eq 1 ]; then
      # TERM only. A language server that ignores it is one that is still doing
      # something, and escalating to -9 here would corrupt an index it may share
      # with a live editor.
      kill -TERM "${pid}" 2>/dev/null || true
    fi
  done < <(ps -eo pid=,ppid=,rss=,times=,comm= 2>/dev/null |
             grep -E "${ORPHAN_MATCH}" || true)

  if [ "${found}" -eq 0 ]; then
    echo "  none"
    return 0
  fi

  if [ "${APPLY}" -eq 1 ]; then
    echo "devaloy-ram: sent TERM to ${found} process(es), $((total / 1024)) MiB"
  else
    echo "devaloy-ram: would TERM ${found} process(es), $((total / 1024)) MiB (--apply to do it)"
  fi
}

# --- dev servers, reported only -------------------------------------------
#
# Never killed. See the header. This block exists because the report is
# incomplete without it: when Paseo and the orphans together account for 800 MB
# and the box is holding 5 GB, this is where the rest went.
report_dev_servers() {
  echo
  echo "devaloy-ram: dev servers and builds (NOT killed — stop these yourself)"
  local found=0
  while read -r pid rss comm; do
    found=$((found + 1))
    printf '  %6s MiB  pid %-7s %s\n' "$((rss / 1024))" "${pid}" "${comm}"
  done < <(ps -eo pid=,rss=,args= --sort=-rss 2>/dev/null |
             grep -E 'next dev|vite|nuxt dev|webpack|turbo run|nodemon|jest --watch|vitest' |
             grep -v grep | head -8 | awk '{print $1, $2, $3, $4, $5}' || true)
  [ "${found}" -eq 0 ] && echo "  none"
  return 0
}

# --- run ------------------------------------------------------------------

report_memory "before"
top_consumers

[ "${DO_PASEO}" -eq 1 ] && do_paseo
[ "${DO_ORPHANS}" -eq 1 ] && do_orphans

report_dev_servers

if [ "${APPLY}" -eq 1 ]; then
  # The kernel does not return freed pages to memory.current instantly, and a
  # TERMed process takes a moment to actually leave. Without this pause the
  # "after" reading is the "before" reading and the script looks like it did
  # nothing.
  sleep 3
  echo
  report_memory "after"
else
  echo
  echo "devaloy-ram: report only. Nothing was killed. Pass --apply to act."
fi
