#!/usr/bin/env bash
# Reclaim disk from the home volume, by hand.
#
# devaloy-prune covers the nested Docker daemon and nothing else. This covers
# the rest of /home/dev, which on a box that has been cloning repos and running
# agents for a month is the larger share: node_modules trees for projects you
# stopped working on, worktrees whose branch merged weeks ago, and package
# manager caches that never shrink on their own.
#
# It matters more when two devaloy boxes share one VPS. Each one has its own
# home volume on the same disk, so the two compete for the same free space, and
# a swap file sized for aggressive swapping is competing with them.
#
# DRY RUN BY DEFAULT. Nothing is deleted until you pass --apply. Read the list
# first — CLAUDE.md's rule about looking before you delete is exactly this case,
# and a node_modules glob that catches the wrong tree costs you an install you
# did not plan for.
#
# Scope is /home/dev only. -xdev keeps every find on the home volume, so a
# mounted project stack volume or /var/lib/docker is never walked.
#
# Usage: devaloy-disk [--apply] [--age <days>] [--docker] [--caches]
#   --apply        actually delete. Without it, this only lists.
#   --age <days>   a node_modules must be untouched this long to qualify.
#                  Default 30.
#   --docker       also hand off to devaloy-prune at the end
#   --caches       also clear the pnpm/npm/mise download caches
set -euo pipefail

APPLY=0
AGE_DAYS=30
DO_DOCKER=0
DO_CACHES=0
ROOT="${HOME:-/home/dev}"

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1; shift ;;
    --age) AGE_DAYS="${2:?--age needs a number of days, e.g. 14}"; shift 2 ;;
    --docker) DO_DOCKER=1; shift ;;
    --caches) DO_CACHES=1; shift ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "devaloy-disk: unknown argument: $1" >&2; exit 2 ;;
  esac
done

act() {
  # Every destructive path goes through here, so the dry run and the real run
  # cannot drift apart. There is no second code path to forget to guard.
  if [ "${APPLY}" -eq 1 ]; then
    "$@"
  fi
}

echo "devaloy-disk: disk before"
df -h "${ROOT}" | tail -1
echo

# --- node_modules ---------------------------------------------------------
#
# -prune is load-bearing: without it find descends INTO each node_modules and
# reports every nested one, so a single project yields hundreds of hits and the
# sizes double-count.
#
# The age test is on the node_modules directory's own mtime, which a package
# manager touches on every install. That makes it a proxy for "when did anyone
# last work here", not a measurement of it. The last commit date is printed
# beside it so you can overrule the proxy by eye before passing --apply.
#
# THE EXCLUSIONS ARE NOT OPTIONAL. pnpm's content-addressable store keeps a
# `node_modules` directory inside every package it has ever linked, and so does
# `.npm/_npx`. Without the first -path group this walk matched 333 of them on
# this box and offered to delete the store itself, which would break every
# project's install at once rather than one project's. Anything you add to this
# list must be pruned BEFORE the -name test, or find still descends into it.
echo "devaloy-disk: node_modules untouched for ${AGE_DAYS}+ days"

NM_LIST="$(mktemp)"
trap 'rm -f "${NM_LIST}"' EXIT

find "${ROOT}" -xdev \
  \( -path "${ROOT}/.local/share/pnpm" \
     -o -path "${ROOT}/.npm" \
     -o -path "${ROOT}/.cache" \
     -o -path "${ROOT}/.bun" \
     -o -path "${ROOT}/.local/share/mise" \
     -o -name '.pnpm' \
     -o -name '.git' \) -prune -o \
  -type d -name node_modules -prune -mtime "+${AGE_DAYS}" \
  -print 2>/dev/null | sort > "${NM_LIST}"

NM_COUNT=0
NM_KB=0
while IFS= read -r nm; do
  [ -n "${nm}" ] || continue
  size_kb="$(du -sk "${nm}" 2>/dev/null | cut -f1)"
  [ -n "${size_kb}" ] || continue
  project="$(dirname "${nm}")"

  # Cheap enough to run per project, and it is the one field that tells you
  # whether the tree is genuinely cold or just installed once and never
  # reinstalled. Prints nothing when the project is not a git repo.
  last_commit="$(git -C "${project}" log -1 --format=%cr 2>/dev/null || true)"
  [ -n "${last_commit}" ] || last_commit="not a git repo"

  printf '  %6s MiB  %s\n' "$((size_kb / 1024))" "${project#${ROOT}/}"
  printf '               last commit: %s\n' "${last_commit}"

  NM_COUNT=$((NM_COUNT + 1))
  NM_KB=$((NM_KB + size_kb))

  act rm -rf "${nm}"
done < "${NM_LIST}"

if [ "${NM_COUNT}" -eq 0 ]; then
  echo "  none"
else
  if [ "${APPLY}" -eq 1 ]; then
    echo "devaloy-disk: removed ${NM_COUNT} tree(s), $((NM_KB / 1024)) MiB"
  else
    echo "devaloy-disk: would remove ${NM_COUNT} tree(s), $((NM_KB / 1024)) MiB"
  fi
fi

# --- dead git worktrees ---------------------------------------------------
#
# `git worktree prune` only removes ADMIN records whose working directory is
# already gone — it never deletes a directory that still exists, so it is safe
# to run everywhere and it reclaims almost nothing on its own. What it does is
# make `git worktree list` honest again.
#
# The real disk is in worktrees that still exist and whose branch has merged.
# Those are NOT deleted here, on purpose: a worktree can hold uncommitted work,
# and this script cannot tell that from a stale checkout. They are listed, and
# the gitkit skill's sweep is the thing that removes them with the branch state
# checked properly.
echo
echo "devaloy-disk: git worktrees"

WT_REPOS=0
while IFS= read -r gitdir; do
  repo="$(dirname "${gitdir}")"
  WT_REPOS=$((WT_REPOS + 1))

  # --porcelain marks an unusable record with a `prunable` line. Anything else
  # is a live worktree.
  prunable="$(git -C "${repo}" worktree list --porcelain 2>/dev/null |
                grep -c '^prunable' || true)"
  extra="$(git -C "${repo}" worktree list 2>/dev/null | tail -n +2 | wc -l || true)"

  [ "${prunable:-0}" -eq 0 ] && [ "${extra:-0}" -eq 0 ] && continue

  echo "  ${repo#${ROOT}/}: ${extra} linked worktree(s), ${prunable} prunable"
  git -C "${repo}" worktree list 2>/dev/null | tail -n +2 | sed 's/^/      /'

  act git -C "${repo}" worktree prune
done < <(find "${ROOT}" -xdev -maxdepth 4 -type d -name .git 2>/dev/null | sort)

[ "${WT_REPOS}" -eq 0 ] && echo "  no git repos found under ${ROOT}"
echo "  (a linked worktree may hold uncommitted work — use gitkit's sweep to"
echo "   remove merged ones, not this script)"

# --- stale mise tool versions ---------------------------------------------
#
# THE BIGGEST RECLAIM ON A BOX THAT HAS BEEN UP FOR WEEKS, and the least
# obvious. Every tool in bootstrap-toolchain.sh that tracks `latest` — claude,
# codex, pnpm, gh — installs a NEW versioned directory on each devaloy-update
# and keeps every older one. Nothing reaps them. Measured on the reference box:
# 18 versions of claude at 4.8 GB and 12 of codex at 3.8 GB, with exactly one of
# each in use.
#
# `mise prune` is the right tool rather than an rm loop here. It reads
# ~/.local/state/mise/tracked-configs and tracked-stubs, keeps whatever is still
# the latest version named in any of them, and deletes the rest along with the
# matching ~/.cache/mise entries. The version you are running is never a
# candidate, so this cannot leave the box without a toolchain.
#
# Reported by default because the size is the argument for running it.
echo
echo "devaloy-disk: stale mise tool versions"

if command -v mise >/dev/null 2>&1; then
  MISE_INSTALLS="${ROOT}/.local/share/mise/installs"
  if [ -d "${MISE_INSTALLS}" ]; then
    du -sk "${MISE_INSTALLS}"/* 2>/dev/null | sort -rn | head -6 |
      while read -r size_kb path; do
        # The count is every installed version of that tool, including the
        # active one, so "18 versions" reads as "17 of these are dead weight".
        versions="$(find "${path}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)"
        printf '  %6s MiB  %-20s %s version(s) installed\n' \
          "$((size_kb / 1024))" "$(basename "${path}")" "${versions}"
      done
  fi

  if [ "${APPLY}" -eq 1 ]; then
    echo "devaloy-disk: pruning unused versions"
    mise prune || true
  else
    echo "devaloy-disk: would run: mise prune"
    echo "devaloy-disk: full list with 'mise prune --dry-run'"
  fi
else
  echo "  mise not on PATH"
fi

# --- Paseo daemon logs ----------------------------------------------------
#
# The daemon writes a new timestamped log per start and rotates none of them.
# Small next to the mise reclaim, but unbounded: on a box where devaloy-ram
# restarts the daemon nightly, this grows a file per night forever.
if [ -d "${ROOT}/.paseo" ]; then
  echo
  echo "devaloy-disk: Paseo daemon logs older than ${AGE_DAYS} days"
  PASEO_LOGS="$(find "${ROOT}/.paseo" -maxdepth 1 -type f -name '*-daemon.log' \
                  -mtime "+${AGE_DAYS}" 2>/dev/null | sort)"
  if [ -z "${PASEO_LOGS}" ]; then
    echo "  none"
  else
    # The live daemon.log is not matched by the glob above — it has no
    # timestamp prefix — so the daemon never loses the file it is writing to.
    echo "${PASEO_LOGS}" | while IFS= read -r f; do
      printf '  %6s KiB  %s\n' "$(du -sk "${f}" 2>/dev/null | cut -f1)" "$(basename "${f}")"
      act rm -f "${f}"
    done
  fi
fi

# --- caches ---------------------------------------------------------------
#
# Opt-in because every one of these costs a re-download on the next install, and
# on a box behind Tailscale that is minutes rather than seconds. Worth it when
# the disk is genuinely full, wasteful otherwise.
if [ "${DO_CACHES}" -eq 1 ]; then
  echo
  echo "devaloy-disk: package manager caches"

  for c in "${ROOT}/.local/share/pnpm/store" "${ROOT}/.npm" \
           "${ROOT}/.cache/mise" "${ROOT}/.cache/turbo"; do
    [ -d "${c}" ] || continue
    size_kb="$(du -sk "${c}" 2>/dev/null | cut -f1)"
    printf '  %6s MiB  %s\n' "$(( ${size_kb:-0} / 1024 ))" "${c#${ROOT}/}"
  done

  if [ "${APPLY}" -eq 1 ]; then
    # `pnpm store prune` rather than rm -rf: it drops packages no lockfile on
    # the box references and keeps the rest, so the projects you still work on
    # reinstall from the store instead of the network.
    command -v pnpm >/dev/null 2>&1 && pnpm store prune || true
    command -v npm >/dev/null 2>&1 && npm cache clean --force >/dev/null 2>&1 || true
    act rm -rf "${ROOT}/.cache/turbo"
    echo "devaloy-disk: caches pruned"
  else
    echo "devaloy-disk: would prune the pnpm store and the npm/turbo caches"
  fi
fi

# --- the nested Docker daemon ---------------------------------------------
#
# Delegated rather than reimplemented. devaloy-prune already handles the
# no-daemon case, the age window and the --all blade, and duplicating its
# filters here is how the two drift.
if [ "${DO_DOCKER}" -eq 1 ]; then
  echo
  if [ "${APPLY}" -eq 1 ]; then
    echo "devaloy-disk: handing off to devaloy-prune"
    devaloy-prune --age "$((AGE_DAYS * 24))h" || true
  else
    echo "devaloy-disk: would run: devaloy-prune --age $((AGE_DAYS * 24))h"
    docker system df 2>/dev/null || echo "  (no Docker daemon on this box)"
  fi
fi

echo
echo "devaloy-disk: disk after"
df -h "${ROOT}" | tail -1

if [ "${APPLY}" -eq 0 ]; then
  echo
  echo "devaloy-disk: dry run. Nothing was deleted. Pass --apply to act."
fi
